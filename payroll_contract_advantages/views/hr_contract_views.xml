<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Odoo 20: contract data is edited on the employee (current version)
         and on contract templates (hr.version) -->
    <record id="advantages_hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.advantages</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='payroll_information']/group[@name='payroll_group']"
                position="after"
            >
                <separator string="Contract Advantages" />
                <field name="advantages_ids">
                    <list editable="bottom">
                        <field
                            name="advantage_template_id"
                            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"
                        />
                        <field name="advantage_template_code" />
                        <field name="advantage_lower_bound" />
                        <field name="advantage_upper_bound" />
                        <field name="amount" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
    <record id="advantages_hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.version.template.form.inherit.advantages</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='salary_info']" position="after">
                <separator string="Contract Advantages" />
                <field name="advantages_ids">
                    <list editable="bottom">
                        <field
                            name="advantage_template_id"
                            options="{'no_quick_create':True,'no_create_edit':True,'no_open': True,}"
                        />
                        <field name="advantage_template_code" />
                        <field name="advantage_lower_bound" />
                        <field name="advantage_upper_bound" />
                        <field name="amount" />
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
